# Obtenha sua chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Configuração do Turso Database (LibSQL)
# Obtenha em https://turso.tech/ ou deixe vazio/file:local.db para SQLite local
DATABASE_URL=libsql://seu-banco-org.turso.io
AUTH_TOKEN=seu_token_turso_aqui

# Configuração JWT
JWT_SECRET_KEY=sua_chave_secreta_jwt_longa_e_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
